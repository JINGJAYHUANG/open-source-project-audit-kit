{
  "$defs": {
    "criterion": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "minLength": 2,
          "type": "string"
        },
        "evidence_expectations": {
          "items": {
            "minLength": 3,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
          "type": "string"
        },
        "question": {
          "minLength": 20,
          "type": "string"
        },
        "weight": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "dimension",
        "question",
        "weight",
        "evidence_expectations"
      ],
      "type": "object"
    },
    "gate": {
      "additionalProperties": false,
      "properties": {
        "fail_cap": {
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
          "type": "string"
        },
        "profiles": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "question": {
          "minLength": 20,
          "type": "string"
        },
        "unknown_cap": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "profiles",
        "question"
      ],
      "type": "object"
    },
    "profile": {
      "additionalProperties": false,
      "properties": {
        "criteria": {
          "items": {
            "$ref": "#/$defs/criterion"
          },
          "minItems": 1,
          "type": "array"
        },
        "purpose": {
          "minLength": 20,
          "type": "string"
        },
        "recommendation_order": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "thresholds": {
          "items": {
            "$ref": "#/$defs/threshold"
          },
          "minItems": 1,
          "type": "array"
        },
        "title": {
          "minLength": 3,
          "type": "string"
        }
      },
      "required": [
        "title",
        "purpose",
        "criteria",
        "recommendation_order",
        "thresholds"
      ],
      "type": "object"
    },
    "threshold": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "minLength": 1,
          "type": "string"
        },
        "minimum_confidence": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "minimum_coverage": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "minimum_score": {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "label",
        "minimum_score",
        "minimum_coverage",
        "minimum_confidence"
      ],
      "type": "object"
    }
  },
  "$id": "https://example.org/open-source-audit/rubric.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evidence_confidence": {
      "additionalProperties": false,
      "properties": {
        "high": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "low": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "medium": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "low",
        "medium",
        "high"
      ],
      "type": "object"
    },
    "gate_statuses": {
      "items": {
        "enum": [
          "pass",
          "fail",
          "unknown",
          "not_applicable"
        ],
        "type": "string"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array",
      "uniqueItems": true
    },
    "gates": {
      "items": {
        "$ref": "#/$defs/gate"
      },
      "type": "array"
    },
    "profiles": {
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      },
      "minProperties": 1,
      "type": "object"
    },
    "rating_scale": {
      "additionalProperties": false,
      "properties": {
        "0": {
          "minLength": 12,
          "type": "string"
        },
        "1": {
          "minLength": 12,
          "type": "string"
        },
        "2": {
          "minLength": 12,
          "type": "string"
        },
        "3": {
          "minLength": 12,
          "type": "string"
        },
        "4": {
          "minLength": 12,
          "type": "string"
        }
      },
      "required": [
        "0",
        "1",
        "2",
        "3",
        "4"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": 1
    }
  },
  "required": [
    "schema_version",
    "rating_scale",
    "evidence_confidence",
    "gate_statuses",
    "gates",
    "profiles"
  ],
  "title": "Open Source Audit Rubric",
  "type": "object"
}
